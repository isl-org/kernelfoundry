def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="copilot-sim",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "-p",
        "--prompt",
        metavar="PROMPT",
        help="Prompt string (overrides piped stdin)",
    )
    parser.add_argument(
        "--allow-all",
        action="store_true",
        help="Auto-approve all agent actions",
    )
    parser.add_argument(
        "--yolo",
        action="store_true",
        help="Alias for --allow-all; skip all safety checks",
    )
    parser.add_argument(
        "--no-ask-user",
        action="store_true",
        help="Suppress interactive clarification questions",
    )
    parser.add_argument(
        "--share",
        nargs="?",
        const=True,
        default=False,
        metavar="FILE",
        help="Share session transcript after completion (optional path)",
    )
    parser.add_argument(
        "--sim-tools",
        action="store_true",
        help="Use simulated (placeholder) tool output instead of the real MCP server",
    )
    parser.add_argument(
        "--task-dir",
        metavar="DIR",
        default=None,
        help="Path to the task directory (default: auto-detected)",
    )
    # ── Flags accepted for compatibility with the real Copilot CLI ───────────
    # The CopilotCLIAgent always passes these; the simulator accepts and
    # ignores them so it can be used as a drop-in replacement for `copilot`.
    parser.add_argument(
        "--resume",
        action="store_true",
        help="(compat) Resume a prior session; ignored by the simulator",
    )
    parser.add_argument(
        "--no-auto-update",
        action="store_true",
        help="(compat) Disable auto-update; ignored by the simulator",
    )
    parser.add_argument(
        "--output-format",
        default="text",
        help="(compat) Output format (text/json); ignored by the simulator",
    )
    return parser


def resolve_task_dir(override: str | None) -> Path:
    if override:
        p = Path(override).expanduser().resolve()
        if not p.is_dir():
            print(f"{RED}error: task directory not found: {p}{RESET}", file=sys.stderr)
            sys.exit(2)
        return p

    # Auto-detect: use the current working directory
    cwd = Path.cwd().resolve()
    if cwd.is_dir():
        return cwd

    print(f"{RED}error: cannot locate task directory. " f"Use --task-dir to specify it.{RESET}", file=sys.stderr)
    sys.exit(2)


def resolve_sycl_file(task_dir: Path) -> Path:
    matches = list(task_dir.glob("*.sycl"))
    if not matches:
        print(f"{RED}error: no .sycl file found in {task_dir}{RESET}", file=sys.stderr)
        sys.exit(2)
    if len(matches) > 1:
        print(f"{YELLOW}warning: multiple .sycl files found; using {matches[0].name}{RESET}", file=sys.stderr)
    return matches[0]


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    # ── Resolve prompt ───────────────────────────────────────────────────────
    prompt: str | None = args.prompt

    if prompt is None:
        if not sys.stdin.isatty():
            prompt = sys.stdin.read().strip()
        else:
            parser.print_help()
            print(
                f"\n{RED}error: provide a prompt via -p or pipe.{RESET}",
                file=sys.stderr,
            )
            sys.exit(2)

    if not prompt:
        print(f"{RED}error: empty prompt.{RESET}", file=sys.stderr)
        sys.exit(2)

    # ── Resolve paths ────────────────────────────────────────────────────────
    task_dir = resolve_task_dir(args.task_dir)
    sycl_file = resolve_sycl_file(task_dir)

    # ── Consolidate flags ────────────────────────────────────────────────────
    allow_all = args.allow_all or args.yolo
    no_ask_user = args.no_ask_user or allow_all
    use_real_tools = not args.sim_tools

    # ── Run ──────────────────────────────────────────────────────────────────
    exit_code = run_simulation(
        prompt=prompt,
        task_dir=task_dir,
        sycl_file=sycl_file,
        allow_all=allow_all,
        no_ask_user=no_ask_user,
        share=args.share,
        use_real_tools=use_real_tools,
    )
    sys.exit(exit_code)


if __name__ == "__main__":
    main()
