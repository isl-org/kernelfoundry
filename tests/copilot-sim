# ---------------------------------------------------------------------------
# Simulation engine
# ---------------------------------------------------------------------------


def confirm_action(prompt: str, auto_approve: bool) -> bool:
    """Ask the user for confirmation unless auto-approve flags are set."""
    if auto_approve:
        print(f"  {DIM}(auto-approved: {prompt}){RESET}")
        return True
    answer = input(f"  {YELLOW}{BOLD}?{RESET}  {prompt} [Y/n] ").strip().lower()
    return answer in ("", "y", "yes")


def run_simulation(
    prompt: str,
    task_dir: Path,
    sycl_file: Path,
    allow_all: bool,
    no_ask_user: bool,
    share: bool,
    use_real_tools: bool,
) -> int:
    """
    Drive the full simulated agent session.
    Returns 0 on success, non-zero on failure.
    """

    # ── Load MCP config once (only needed for real tools) ────────────────────
    mcp_config: dict | None = None
    if use_real_tools:
        try:
            mcp_config = _load_mcp_config(task_dir)
        except FileNotFoundError as exc:
            print(f"{RED}error: {exc}{RESET}", file=sys.stderr)
            return 2

    # ── Session header ───────────────────────────────────────────────────────
    banner("GitHub Copilot CLI — Simulated Agent Session", CYAN)
    print(f"  {BOLD}Task directory:{RESET} {task_dir}")
    print(f"  {BOLD}Target file:   {RESET} {sycl_file.relative_to(task_dir.parent)}")
    print(
        f"  {BOLD}Flags:         {RESET} "
        f"allow_all={allow_all}  no_ask_user={no_ask_user}  share={share}  "
        f"sim_tools={not use_real_tools}"
    )
    print()
    section("User Prompt", YELLOW)
    print(f"  {YELLOW}{prompt}{RESET}\n")
    pause(0.5)

    # ── Step 1: Read the current source ─────────────────────────────────────
    section("Step 1 — Reading task file")
    agent_say(
        "I'll start by reading the current kernel source to understand the "
        "EVOLVE region boundaries and the surrounding context."
    )
    pause(0.3)

    tool_call("read_file", {"path": str(sycl_file.relative_to(task_dir.parent))})
    source = read_file(sycl_file)
    # Show only the EVOLVE region snippet
    lines = source.splitlines()
    evolve_lines = []
    inside = False
    for ln in lines:
        if EVOLVE_START in ln:
            inside = True
        if inside:
            evolve_lines.append(ln)
        if EVOLVE_END in ln and inside:
            break
    snippet = "\n".join(evolve_lines[:6]) + "\n  ... (truncated)"
    tool_result("OK — file read", snippet, success=True)
    pause(0.4)

    # ── Step 2: Inject broken kernel ─────────────────────────────────────────
    section("Step 2 — Injecting initial (broken) kernel candidate")
    agent_say(
        "I'll replace the EVOLVE region with an initial kernel attempt. "
        "This draft has several bugs that I expect the compiler to catch, "
        "so I can use the error messages to guide my next iteration."
    )
    pause(0.3)

    if not allow_all and not no_ask_user:
        ok = confirm_action("Write broken kernel candidate to file?", auto_approve=False)
        if not ok:
            print(f"  {RED}Aborted by user.{RESET}")
            return 1
    else:
        print(f"  {DIM}(--allow-all / --yolo: writing without confirmation){RESET}")

    tool_call(
        "edit_file",
        {
            "path": str(sycl_file.relative_to(task_dir.parent)),
            "region": "[EVOLVE_START] … [EVOLVE_END]",
            "new_content": BROKEN_KERNEL.strip(),
        },
    )
    broken_source = replace_evolve_region(sycl_file, BROKEN_KERNEL)
    sycl_file.write_text(broken_source, encoding="utf-8")
    tool_result("OK — EVOLVE region updated with broken kernel", "", success=True)
    pause(0.4)

    # ── Step 3: build_and_test — expected to fail ────────────────────────────
    section("Step 3 — Running build_and_test (expecting failure)")
    agent_say(
        "Let me compile and test the current candidate. I expect this to "
        "fail; the error output will tell me exactly what to fix."
    )
    pause(0.3)

    tool_call(
        "build_and_test",
        {
            "folder_path": str(task_dir),
        },
    )

    if use_real_tools:
        assert mcp_config is not None
        print(f"  {DIM}[real MCP call — connecting to KernelFoundry server …]{RESET}")
        try:
            success, output = call_build_and_test_real(task_dir, mcp_config)
        except Exception as exc:
            tool_result("ERROR — MCP call failed", str(exc), success=False)
            return 1
        tool_result(
            "PASSED — build and tests succeeded" if success else "FAILED — see log",
            output,
            success=success,
        )
        if success:
            # Broken kernel unexpectedly passed — warn but continue
            print(f"  {YELLOW}warning: broken kernel passed unexpectedly; " f"proceeding to fix anyway.{RESET}\n")
    else:
        pause(0.6)
        tool_result("FAILED — compilation errors", BUILD_FAIL_OUTPUT, success=False)

    # ── Step 4: Analyse failures ─────────────────────────────────────────────
    section("Step 4 — Analysing compiler diagnostics")
    agent_say(
        "Three errors identified:\n"
        "  1. sycl::queue default-constructor is invalid — must obtain the XPU "
        "     queue from c10::xpu::getCurrentXPUStream().queue().\n"
        "  2. nd_range dimension mismatch — the kernel is 2-D (tile_m × tile_n) "
        "     but was given a 1-D range.\n"
        "  3. 'undeclared_xmx_mad' — must use the proper joint_matrix API: "
        "     joint_matrix_load / joint_matrix_mad / joint_matrix_store.\n"
        "I'll now rewrite the EVOLVE region with a correct XMX DPAS kernel."
    )
    pause(0.5)

    # ── Step 5: Inject correct kernel ────────────────────────────────────────
    section("Step 5 — Applying corrected kernel")

    if not allow_all and not no_ask_user:
        ok = confirm_action("Write corrected kernel to file?", auto_approve=False)
        if not ok:
            print(f"  {RED}Aborted by user.{RESET}")
            return 1
    else:
        print(f"  {DIM}(--allow-all / --yolo: writing without confirmation){RESET}")

    tool_call(
        "edit_file",
        {
            "path": str(sycl_file.relative_to(task_dir.parent)),
            "region": "[EVOLVE_START] … [EVOLVE_END]",
            "new_content": CORRECT_KERNEL.strip(),
        },
    )
    correct_source = replace_evolve_region(sycl_file, CORRECT_KERNEL)
    sycl_file.write_text(correct_source, encoding="utf-8")
    tool_result("OK — EVOLVE region updated with corrected kernel", "", success=True)
    pause(0.4)

    # ── Step 6: build_and_test — expected to pass ────────────────────────────
    section("Step 6 — Running build_and_test (expecting success)")
    agent_say(
        "Re-running the full build + test suite with the corrected XMX DPAS " "kernel. All fixes have been applied."
    )
    pause(0.3)

    tool_call(
        "build_and_test",
        {
            "folder_path": str(task_dir),
        },
    )

    if use_real_tools:
        assert mcp_config is not None
        print(f"  {DIM}[real MCP call — connecting to KernelFoundry server …]{RESET}")
        try:
            success, output = call_build_and_test_real(task_dir, mcp_config)
        except Exception as exc:
            tool_result("ERROR — MCP call failed", str(exc), success=False)
            return 1
        tool_result(
            "PASSED — all tests green" if success else "FAILED — see log",
            output,
            success=success,
        )
        final_ok = success
    else:
        pause(0.7)
        tool_result("PASSED — all tests green", BUILD_PASS_OUTPUT, success=True)
        final_ok = True

    # ── Session summary ───────────────────────────────────────────────────────
    banner("Session Complete", GREEN if final_ok else RED)
    agent_say(
        "The EVOLVE region in matrix_mul_kernel.sycl has been successfully "
        "updated with a correct XMX DPAS joint_matrix kernel for the "
        "Xe2 (Lunar Lake) architecture.  All 4 test cases pass.\n\n"
        "Key changes made:\n"
        "  • Obtained the device queue via getCurrentXPUStream().queue()\n"
        "  • Used 2-D nd_range<2> with SIMD16 sub-group size\n"
        "  • Replaced placeholder with proper joint_matrix_load / "
        "    joint_matrix_mad / joint_matrix_store calls\n"
        "  • Added q.wait_and_throw() to synchronise results"
    )

    if share:
        print(f"  {DIM}[--share] Session transcript would be uploaded to " f"copilot.github.com/sessions/…{RESET}\n")

    return 0 if final_ok else 1


