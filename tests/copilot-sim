# ── Broken kernel: syntactically invalid / will not compile ──────────────────
BROKEN_KERNEL = r"""
class MatmulXMXKernel;

// BROKEN: placeholder kernel — intentionally non-compiling
void sycl_matmul_kernel(sycl::half* A,
                        sycl::half* B,
                        float* C,
                        int M_tiles, int K, int N_tiles,
                        int lda, int ldb, int ldc) {

    // BUG 1: default-constructing sycl::queue is invalid in this context
    sycl::queue q;

    // BUG 2: wrong nd_range dimensionality for a 2-D tiled kernel
    sycl::range<1> global{ static_cast<size_t>(M_tiles * N_tiles) };

    q.submit([&](sycl::handler& h) {
        h.parallel_for<MatmulXMXKernel>(global,
            [=](sycl::item<1> item) {
                int idx = item.get_id(0);

                // BUG 3: sub_group not obtained; joint_matrix ops will fail
                joint_matrix<sycl::sub_group, sycl::half,
                             use::a, TM, TK, layout::row_major> matA;

                // BUG 4: calling an undeclared function
                undeclared_xmx_mad(matA, A, B, C);
            });
    });

    // BUG 5: missing q.wait_and_throw() — results would be unobserved
}
"""

# ── Correct kernel: matches the original source ──────────────────────────────
CORRECT_KERNEL = r"""
class MatmulXMXKernel;

// A: (M_tiles*TM) x K, row-major, stride lda=K
// B: K x (N_tiles*TN), row-major, stride ldb=N_tiles*TN
// C: (M_tiles*TM) x (N_tiles*TN), row-major, stride ldc=N_tiles*TN  (float32 output)
void sycl_matmul_kernel(sycl::half* A,
                        sycl::half* B,
                        float* C,
                        int M_tiles, int K, int N_tiles,
                        int lda, int ldb, int ldc) {
    sycl::queue& q = c10::xpu::getCurrentXPUStream().queue();

    sycl::range<2> global{ static_cast<size_t>(M_tiles * SG_SIZE),
                           static_cast<size_t>(N_tiles) };
    sycl::range<2> local{ SG_SIZE, 1 };

    q.submit([&](sycl::handler& h) {
        h.parallel_for<MatmulXMXKernel>(sycl::nd_range<2>{global, local},
            [=](sycl::nd_item<2> item) [[sycl::reqd_sub_group_size(SG_SIZE)]] {
                namespace as = sycl::access;
                auto sg = item.get_sub_group();
                int tile_m = item.get_group(0);
                int tile_n = item.get_group(1);

                joint_matrix<sycl::sub_group, sycl::half, use::a, TM, TK, layout::row_major> matA;
                joint_matrix<sycl::sub_group, sycl::half, use::b, TK, TN, layout::row_major> matB;
                joint_matrix<sycl::sub_group, float, use::accumulator, TM, TN> matC;

                joint_matrix_fill(sg, matC, 0.0f);

                for (int k = 0; k < K / TK; ++k) {
                    joint_matrix_load(sg, matA,
                        sycl::address_space_cast<as::address_space::global_space, as::decorated::no>(
                            A + tile_m * TM * lda + k * TK),
                        static_cast<size_t>(lda));
                    joint_matrix_load(sg, matB,
                        sycl::address_space_cast<as::address_space::global_space, as::decorated::no>(
                            B + k * TK * ldb + tile_n * TN),
                        static_cast<size_t>(ldb));
                    joint_matrix_mad(sg, matC, matA, matB, matC);
                }

                joint_matrix_store(sg, matC,
                    sycl::address_space_cast<as::address_space::global_space, as::decorated::no>(
                        C + tile_m * TM * ldc + tile_n * TN),
                    static_cast<size_t>(ldc), layout::row_major);
            });
    });
    q.wait_and_throw();
}
"""

# ---------------------------------------------------------------------------
# MCP client — real build_and_test
# ---------------------------------------------------------------------------


def _load_mcp_config(task_dir: Path) -> dict:
    """
    Look for MCP config in COPILOT_HOME/mcp-config.json first, then fall back
    to .mcp.json starting from *task_dir* and walking up to home.
    Returns the parsed JSON dict, or raises FileNotFoundError.
    """
    copilot_home = os.environ.get("COPILOT_HOME")
    if copilot_home:
        candidate = Path(copilot_home) / "mcp-config.json"
        if candidate.exists():
            return json.loads(candidate.read_text(encoding="utf-8"))

    search = [task_dir] + list(task_dir.parents)
    home = Path.home()
    for directory in search:
        candidate = directory / ".mcp.json"
        if candidate.exists():
            return json.loads(candidate.read_text(encoding="utf-8"))
        if directory == home:
            break
    raise FileNotFoundError(
        "No .mcp.json found in task directory or any parent up to $HOME. " "Use --sim-tools to skip the real MCP call."
    )


def _mcp_env(mcp_config: dict) -> dict[str, str]:
    """Extract the env block from the first mcpServers entry."""
    servers = mcp_config.get("mcpServers", {})
    if not servers:
        return {}
    first = next(iter(servers.values()))
    return first.get("env", {})


async def _call_build_and_test_async(
    task_dir: Path,
    mcp_config: dict,
    progress_cb,
) -> tuple[bool, str]:
    """
    Invoke the real build_and_test MCP tool via fastmcp.Client.
    Returns (success: bool, display_text: str).
    """
    try:
        from fastmcp import Client
    except ImportError:
        raise RuntimeError(
            "fastmcp is not installed in the current environment. " "Activate the project venv or pass --sim-tools."
        )

    last_progress: list[int] = [0]

    async def _progress_handler(progress: float, total: float | None, message: str | None) -> None:
        pct = int(progress / (total or 100) * 100)
        if pct != last_progress[0]:
            last_progress[0] = pct
            progress_cb(pct)

    async with Client(mcp_config, progress_handler=_progress_handler) as client:
        result = await client.call_tool(
            "build_and_test",
            {"folder_path": str(task_dir)},
        )

    # structured_content holds the typed return dict {success, job_id, eval_log}
    data: dict = result.structured_content or {}
    job_id = data.get("job_id", "?")

    # Flatten eval_log to a string
    eval_log = data.get("eval_log") or ""
    if isinstance(eval_log, list):
        display_log = "\n".join(str(entry) for entry in eval_log if entry)
    else:
        display_log = str(eval_log) if eval_log else "(no log returned)"

    # The MCP "success" flag means the job ran to completion, not that the
    # build/tests passed.  Determine real outcome from the eval_log content:
    # a build failure starts with "FAILED:" in the log.
    job_completed = bool(data.get("success", not result.is_error))
    build_failed = display_log.lstrip().startswith("FAILED:")
    success = job_completed and not build_failed

    print(f"{DIM}[debug] job_completed={job_completed}  build_failed={build_failed}  success={success}{RESET}\n")

    header = f"[job_id: {job_id}]  status: {'SUCCESS' if success else 'FAILED'}\n"
    return success, header + display_log


def call_build_and_test_real(
    task_dir: Path,
    mcp_config: dict,
) -> tuple[bool, str]:
    """Synchronous wrapper around the async MCP call."""

    spinner_chars = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    spin_idx = [0]
    last_pct = [0]

    def _progress(pct: int) -> None:
        last_pct[0] = pct
        char = spinner_chars[spin_idx[0] % len(spinner_chars)]
        spin_idx[0] += 1
        sys.stdout.write(f"\r  {DIM}{char} Running … {pct:3d}%{RESET}  ")
        sys.stdout.flush()

    result = asyncio.run(_call_build_and_test_async(task_dir, mcp_config, _progress))
    sys.stdout.write(f"\r{' ' * 40}\r")  # clear spinner line
    sys.stdout.flush()
    return result


