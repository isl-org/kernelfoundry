#!/usr/bin/env python3
"""
copilot-sim — Simulates a programmatic GitHub Copilot CLI agent session.

The agent operates on a task directory, replacing the EVOLVE region in a .sycl
file: first injecting a broken kernel, running build_and_test (which fails),
then fixing the kernel and re-running build_and_test (which passes).

By default the build_and_test steps call the real KernelFoundry MCP server
(configured via .mcp.json in the task directory or its parent).  Pass
--sim-tools to use placeholder/simulated output instead.

Usage:
  echo "Fix the matmul kernel" | copilot-sim [FLAGS]
  copilot-sim -p "Fix the matmul kernel" [FLAGS]

Flags:
  -p PROMPT         Prompt string (alternative to piped stdin)
  --allow-all       Auto-approve all agent actions (no confirmation prompts)
  --yolo            Alias for --allow-all; skip all safety checks
  --no-ask-user     Suppress interactive clarification questions
  --share           Share session transcript after completion
  --sim-tools       Use simulated (placeholder) tool calls instead of the
                    real MCP build_and_test tool
  -h, --help        Show this help message
"""

import argparse
import asyncio
import json
import os
import re
import sys
import textwrap
import time
from pathlib import Path

# ---------------------------------------------------------------------------
# Terminal helpers
# ---------------------------------------------------------------------------

# This script prints box-drawing characters, and the agent under test runs it with stdout
# redirected to a file. On Windows a redirected stream defaults to the locale codec (cp1252),
# which cannot encode them, so the very first banner raised UnicodeEncodeError and the whole
# simulated session died with exit 1 -- surfacing in the agent as a FileNotFoundError for the
# telemetry file the session never got far enough to write. Name the codec explicitly.
for _stream in (sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(encoding="utf-8", errors="replace")

USE_COLOR = sys.stdout.isatty()

RESET = "\033[0m" if USE_COLOR else ""
BOLD = "\033[1m" if USE_COLOR else ""
DIM = "\033[2m" if USE_COLOR else ""
CYAN = "\033[36m" if USE_COLOR else ""
GREEN = "\033[32m" if USE_COLOR else ""
YELLOW = "\033[33m" if USE_COLOR else ""
RED = "\033[31m" if USE_COLOR else ""
BLUE = "\033[34m" if USE_COLOR else ""
MAGENTA = "\033[35m" if USE_COLOR else ""


def banner(text: str, color: str = CYAN) -> None:
    width = 72
    print(f"\n{color}{BOLD}{'─' * width}{RESET}")
    print(f"{color}{BOLD}  {text}{RESET}")
    print(f"{color}{BOLD}{'─' * width}{RESET}\n")


def section(label: str, color: str = BLUE) -> None:
    print(f"{color}{BOLD}▶ {label}{RESET}")


def agent_say(text: str) -> None:
    """Render an agent thought/speech bubble."""
    wrapped = textwrap.fill(text, width=68, initial_indent="  ", subsequent_indent="  ")
    print(f"{DIM}┌{'─' * 70}┐{RESET}")
    for line in wrapped.splitlines():
        print(f"{DIM}│{RESET} {line:<68} {DIM}│{RESET}")
    print(f"{DIM}└{'─' * 70}┘{RESET}")
    print()


def tool_call(name: str, inputs: dict) -> None:
    """Display a simulated tool call header."""
    print(f"\n{MAGENTA}{BOLD}⚙  TOOL CALL → {name}{RESET}")
    print(f"{DIM}{'·' * 72}{RESET}")
    for k, v in inputs.items():
        if isinstance(v, str) and "\n" in v:
            print(f"  {BOLD}{k}:{RESET}")
            for line in v.splitlines():
                print(f"    {DIM}{line}{RESET}")
        else:
            print(f"  {BOLD}{k}:{RESET} {v}")
    print(f"{DIM}{'·' * 72}{RESET}")


def tool_result(status: str, output: str, success: bool = True) -> None:
    """Display a simulated tool result."""
    icon = f"{GREEN}✔{RESET}" if success else f"{RED}✘{RESET}"
    color = GREEN if success else RED
    print(f"  {icon}  {color}{BOLD}[{status}]{RESET}")
    for line in output.strip().splitlines():
        print(f"  {DIM}{line}{RESET}")
    print()


def pause(seconds: float = 0.4) -> None:
    time.sleep(seconds)


# ---------------------------------------------------------------------------
# File manipulation helpers
# ---------------------------------------------------------------------------

EVOLVE_START = "// [EVOLVE_START]"
EVOLVE_END = "// [EVOLVE_END]"


def read_file(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def replace_evolve_region(path: Path, new_body: str) -> str:
    """
    Replace the content between [EVOLVE_START] and [EVOLVE_END] markers
    (keeping the markers themselves) with *new_body*.
    Returns the full new file content.
    """
    source = read_file(path)
    pattern = re.compile(
        r"(// \[EVOLVE_START\]).*?(// \[EVOLVE_END\])",
        re.DOTALL,
    )
    replacement = f"{EVOLVE_START}\n\n{new_body.strip()}\n// [EVOLVE_END]"
    new_source, count = pattern.subn(replacement, source)
    if count == 0:
        raise ValueError(f"EVOLVE markers not found in {path}")
    return new_source


